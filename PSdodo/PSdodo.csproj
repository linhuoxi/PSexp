<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ico.ico</ApplicationIcon>
    <AssemblyName>PSexpV3</AssemblyName>
    <RootNamespace>PsExporter</RootNamespace>
    <Version>3.0.1</Version>
    <AssemblyTitle>PSexp v3.0</AssemblyTitle>
    <Product>PSexp v3.0</Product>
    <!-- 默认单文件只捆绑应用依赖，不捆绑 .NET；运行需要 .NET 10 x64 Runtime。 -->
    <PublishSelfContained Condition="'$(PublishSelfContained)' == ''">false</PublishSelfContained>
    <!-- 是否自包含和目标 RID 由发布命令指定，避免测试项目引用时被视为自包含 EXE。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- .NET SDK 仅允许自包含单文件使用压缩；默认依赖系统 .NET 的发布必须关闭。 -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'true' or '$(PublishSingleFile)' != 'true'">false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 无需把托管程序集全部解压到临时目录；可减小启动 I/O，并保留单文件语义 -->
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <!-- 源码已按 MIT 公开，混淆不再具有保护意义，默认关闭；需要时由发布 BAT 显式传 true 启用。 -->
    <!-- 内置压缩按发布模式启用：它只影响体积，不隐藏代码。 -->
    <EnableReleaseObfuscation Condition="'$(EnableReleaseObfuscation)' == '' and '$(Configuration)' == 'Release'">false</EnableReleaseObfuscation>
    <!-- 默认稳定模式不裁剪；仅由 BAT 的 PSexpEnableTrim=1 显式启用实验裁剪。 -->
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <TrimMode Condition="'$(TrimMode)' == ''">partial</TrimMode>
    <!-- Photoshop 脚本桥依赖动态 COM；稳定模式必须保留完整 COM/DOM 路径。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 动态 COM 调用由 C# RuntimeBinder 生成调用点，需要保留动态代码路径。 -->
    <DynamicCodeSupport>true</DynamicCodeSupport>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 裁剪依赖库时完整保留业务程序集和动态 COM 绑定器，避免反射/JSON/Avalonia 绑定失效。 -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- 内置 ExtendScript 脚本作为嵌入资源，对用户透明 -->
  <!-- 默认资源名规则：根命名空间.相对路径(分隔符转点).文件名 -->
  <!-- 即 PsExporter.Resources.Scripts.probe.document_info.jsx -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Scripts\**\*.jsx" />
    <EmbeddedResource Include="Resources\Scripts\**\*.psjs" />
    <EmbeddedResource Include="Resources\Updates\update-public-key.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- 在 .NET 单文件捆绑前混淆本项目程序集。 -->
  <Import Project="Obfuscation.targets" />

</Project>
