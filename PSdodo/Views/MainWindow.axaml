<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PsExporter.Controls"
        xmlns:vm="using:PsExporter.ViewModels"
        xmlns:models="using:PsExporter.Models"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PsExporter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ico.ico"
        Title="PSexp v3.0"
        Width="{x:Static models:AppSettings.DefaultWindowWidth}"
        Height="{x:Static models:AppSettings.DefaultWindowHeight}"
        MinWidth="{x:Static models:AppSettings.MinimumWindowWidth}"
        MinHeight="{x:Static models:AppSettings.MinimumWindowHeight}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Classes.quality-motion="{Binding EnableQualityHoverAnimation}"
        Topmost="{Binding EffectiveTopmost}">

    <Grid x:Name="RootGrid">
        <controls:ContinuousBorder x:Name="MainContentBorder"
                Background="{StaticResource Brush.Canvas}"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Lg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Header TitleBar -->
                <controls:ContinuousBorder Grid.Row="0"
                        Background="{StaticResource Brush.Surface}"
                        BorderThickness="0"
                        Padding="0"
                        Height="{StaticResource Control.CaptionHeight}"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Application Logo -->
                        <Image Margin="16,0,0,0" Width="{StaticResource Control.LogoSize}"
                               Height="{StaticResource Control.LogoSize}"
                               Source="/Assets/ico.ico"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="PSexp v3.0"
                                   TextTrimming="CharacterEllipsis"
                                   Classes="subtitle"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding RefreshStatusCommand}"
                                IsEnabled="{Binding CanRefreshStatus}"
                                ToolTip.Tip="刷新 Photoshop 状态与当前文档">
                            <TextBlock x:Name="RefreshIcon"
                                       Text="{StaticResource Icon.Refresh}"
                                       Classes="icon"
                                       Foreground="{Binding IsRefreshingStatus, Converter={x:Static vm:BoolToRefreshBrushConverter.Instance}}"
                                       RenderTransformOrigin="50%,50%"/>
                        </Button>
                        <Button Grid.Column="3"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ToggleAlwaysOnTopCommand}"
                                ToolTip.Tip="窗口置顶">
                            <controls:ContinuousBorder Background="{Binding IsAlwaysOnTop, Converter={x:Static vm:BoolToSettingBrushConverter.Instance}}"
                                    CornerRadius="{StaticResource Radius.SegmentInner}"
                                    Width="{StaticResource Control.ToolSize}"
                                    Height="{StaticResource Control.ToolSize}" BorderBrush="{Binding IsAlwaysOnTop, Converter={x:Static vm:ChoiceBorderConverter.Instance}}" BorderThickness="1">
                                <TextBlock Text="{StaticResource Icon.Pin}"
                                           Classes="icon"
                                           Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:BoolToIconColorConverter.Instance}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </controls:ContinuousBorder>
                        </Button>
                        <Button Grid.Column="4"
                                Margin="8,0,8,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ShowSettingsCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                ToolTip.Tip="设置">
                            <TextBlock Text="{StaticResource Icon.Settings}" Classes="icon"/>
                        </Button>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Classes="tool caption" Click="OnMinimizeClick"
                                    chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                                    ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
                                <Path Classes="caption-glyph" Data="M0 0H12V1H0Z" Width="12" Height="1" Stretch="Fill"
                                      Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                            <Button Classes="tool caption close" Click="OnCloseClick"
                                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                    ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
                                <Path Classes="caption-glyph" Data="M0 0L12 12 M12 0L0 12" Width="12" Height="12" Stretch="Fill"
                                      StrokeThickness="1.3" Stroke="{Binding $parent[Button].Foreground}"/>
                            </Button>
                        </StackPanel>
                        <controls:ContinuousBorder Grid.ColumnSpan="6" Height="1" VerticalAlignment="Bottom"
                            Background="{StaticResource Brush.Divider}" IsHitTestVisible="False"/>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 1. Photoshop Connection Console -->
                <controls:ContinuousBorder Grid.Row="1"
                        Margin="16,12,16,6"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.StatusBorder}"
                        BorderThickness="{StaticResource Thickness.Thin}"
                        CornerRadius="{StaticResource Radius.Md}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="5,*">
                        <controls:ContinuousBorder Grid.Column="0"
                                Background="Transparent"/>

                        <Grid Grid.Column="1"
                              Margin="13,12,13,12"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="当前 Photoshop 文档"
                                           Classes="micro"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="PsStatusDot"
                                         Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding IsPsRunning, Converter={x:Static vm:BoolToStatusBrushConverter.Instance}}"
                                         RenderTransformOrigin="50%,50%"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding DocumentDisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,1,*,1,*"
                                  ColumnSpacing="12"
                                  HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="PS 版本"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding PsVersionDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="1"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="画布尺寸"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding DocumentSizeDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="3"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <controls:ContinuousBorder Grid.Column="4"
                                        Background="{StaticResource Brush.Accent}"
                                        CornerRadius="{StaticResource Radius.Sm}"
                                        Padding="9,5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="当前模式"
                                                   Classes="micro"
                                                   Foreground="#DDE0FF"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentModeTitle}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 2. Mode Selector: 4 Equal Columns Segmented Control -->
                <controls:AnimatedSegmentTrack Grid.Row="2"
                        Margin="16,6,16,6"
                        IsVisible="{Binding !IsViewSetting}" Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.QuickExport}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="快速导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.QuickExport}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="1"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.AllArtboards}"
                                controls:AnimatedSegmentTrack.SelectionAlias="{x:Static models:ExportMode.SelectedArtboards}"
                                IsEnabled="{Binding CanUseArtboards}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="画板导出"
                                           Classes="mode-label"
                                           Foreground="{Binding IsArtboardMode, Converter={x:Static vm:BoolToIconColorConverter.Instance}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Layers}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="图层导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Layers}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="3"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Slices}"
                                IsEnabled="{Binding CanUseSlices}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="切片导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Slices}}"/>
                            </controls:ContinuousBorder>
                        </Button>
                    </Grid>
                </controls:AnimatedSegmentTrack>

                <!-- 参数与任务状态按内容排布，共用一个受窗口约束的滚动区。 -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ExportScrollViewer" Classes="subtle-scroll"
                        IsVisible="{Binding !IsViewSetting}" AllowAutoHide="False"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <controls:ContinuousBorder Margin="16,6,16,12"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Padding.Panel}">
                                <!-- Export Panel -->
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="{StaticResource Space.Md}">

                                    <controls:ContinuousBorder Grid.Row="0" Classes="workspace-heading">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <controls:ContinuousBorder Width="4"
                                                        Height="22"
                                                        Background="{StaticResource Brush.Accent}"
                                                        CornerRadius="2"/>
                                                <TextBlock Text="{Binding CurrentModeTitle}"
                                                           Classes="title"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Classes="output-meta" Orientation="Horizontal" Height="{StaticResource Control.BadgeHeight}"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="输出参数"
                                                           Classes="micro meta-label"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           VerticalAlignment="Center"/>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="JPG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding !IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="PNG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.StatusSurface}"
                                                        BorderBrush="{StaticResource Brush.StatusBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.StatusText}"
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding Quality}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </controls:ContinuousBorder>
                                            </StackPanel>
                                        </Grid>
                                    </controls:ContinuousBorder>

                                        <StackPanel Grid.Row="1" Margin="0,6,0,8" Spacing="16">
                                            <!-- 1. Path Line -->
                                            <Grid ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="输出位置" Classes="label"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.Sm}">
                                                    <controls:ContinuousBorder    Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0" Text="{Binding ExportPath}"
                                                             PlaceholderText="选择导出文件夹"
                                                             VerticalContentAlignment="Center"
                                                             Padding="10,0"/></controls:ContinuousBorder>
                                                    <Button Grid.Column="1"
                                                            Classes="folder"
                                                            Command="{Binding BrowseExportFolderCommand}"
                                                            ToolTip.Tip="选择导出文件夹"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>

                                            <!-- 2. Format Selector -->
                                            <Grid ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="图片格式" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding Format}">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SetFormatCommand}"
                                                                CommandParameter="{x:Static models:ExportFormat.Jpg}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="JPG 格式"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Jpg}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SetFormatCommand}"
                                                                CommandParameter="{x:Static models:ExportFormat.Png}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="PNG 无损"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Png}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <StackPanel IsVisible="{Binding IsLayerMode}" Spacing="8">
                                                <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                                    <TextBlock Text="图层范围" Classes="label"/>
                                                    <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding LayerExportRecursive}" IsEnabled="{Binding !IsExporting}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="一级图层" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="全部图层" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Grid>
                                                <StackPanel Margin="88,0,0,0" Spacing="4">
                                                    <TextBlock Text="{Binding LayerModeHint}" Classes="setting-description" TextWrapping="Wrap"/>
                                                    <TextBlock Text="名称以“排除”开头的图层或图层组不单独导出；组内子图层也跳过。背景及排除项保留原显示状态，作为合成内容。符合条件的隐藏图层也会导出。" Classes="setting-description" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 3. Quality: one field, one surface -->
                                            <Grid x:Name="QualityControl" Cursor="Arrow" ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center" IsVisible="{Binding IsJpgFormat}">
                                                <TextBlock Text="图片质量" Classes="label"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="12">
                                                    <Grid x:Name="QualityMeter"
                                                              Cursor="Arrow"
                                                              Grid.Column="0"
                                                              ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
                                                              ColumnSpacing="1.5"
                                                              Height="{StaticResource Control.StandardHeight}"
                                                              VerticalAlignment="Center"
                                                              Background="Transparent"
                                                              ClipToBounds="False">
<Button Grid.Column="0" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="4" ToolTip.Tip="4%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=4}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="1" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="8" ToolTip.Tip="8%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=8}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="2" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="12" ToolTip.Tip="12%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=12}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="3" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="16" ToolTip.Tip="16%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=16}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="4" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="20" ToolTip.Tip="20%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=20}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="5" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="24" ToolTip.Tip="24%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=24}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="6" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="28" ToolTip.Tip="28%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=28}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="7" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="32" ToolTip.Tip="32%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=32}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="8" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="36" ToolTip.Tip="36%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=36}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="9" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="40" ToolTip.Tip="40%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=40}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="10" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="44" ToolTip.Tip="44%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=44}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="11" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="48" ToolTip.Tip="48%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=48}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="12" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="52" ToolTip.Tip="52%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=52}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="13" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="56" ToolTip.Tip="56%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=56}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="14" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="60" ToolTip.Tip="60%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=60}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="15" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="64" ToolTip.Tip="64%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=64}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="16" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="68" ToolTip.Tip="68%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=68}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="17" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="72" ToolTip.Tip="72%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=72}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="18" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="76" ToolTip.Tip="76%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=76}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="19" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="80" ToolTip.Tip="80%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=80}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="20" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="84" ToolTip.Tip="84%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=84}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="21" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="88" ToolTip.Tip="88%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=88}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="22" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="92" ToolTip.Tip="92%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=92}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="23" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="96" ToolTip.Tip="96%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=96}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="24" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="100" ToolTip.Tip="100%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=100}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
                                                        </Grid>
                                                    <controls:ContinuousBorder Grid.Column="1" Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}"
                                                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBox x:Name="QualityInput" Text="{Binding Quality}" Height="{StaticResource Control.InputInnerHeight}" MinWidth="0" Padding="6,0,0,0"
                                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="%" Margin="0,0,8,0" Classes="hint" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </controls:ContinuousBorder>
                                                </Grid>
                                            </Grid>

                                            <!-- 4. Artboard export range -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsArtboardMode}">
                                                <TextBlock Grid.Column="0" Text="导出范围" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.AllArtboards}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="全部画板"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.AllArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.SelectedArtboards}"
                                                                ToolTip.Tip="导出 Photoshop 中当前选中的画板">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="当前选中"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.SelectedArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <!-- 5. Artboard save location -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsArtboardMode}">
                                                <TextBlock Grid.Column="0" Text="保存位置" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding ExportPathOption}">
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.ImageOnly}"
                                                                ToolTip.Tip="直接将画板图片保存到当前选择的输出目录">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="图片直出"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.ImageOnly}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>

                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.NewFolder}"
                                                                ToolTip.Tip="按当前 Photoshop 文档名新建文件夹；重名时自动追加序号，保留旧结果">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="文档文件夹"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolder}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>

                                                        <Button Grid.Column="2"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.NewFolderOverwrite}"
                                                                ToolTip.Tip="使用当前 Photoshop 文档名文件夹；已存在时复用，并更新本次同名导出文件">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="覆盖文件夹"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolderOverwrite}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <!-- 6. Mode-specific name -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsImageNameVisible}">
                                                <TextBlock Grid.Column="0" Text="{Binding ImageNameLabel}" Classes="label"/>
                                                <controls:ContinuousBorder Grid.Column="1"  Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0" 
                                                         Text="{Binding ImageName}"
                                                         PlaceholderText="{Binding ImageNamePlaceholder}"
                                                         VerticalContentAlignment="Center"
                                                         Padding="10,0"/></controls:ContinuousBorder>
                                            </Grid>

                                            <!-- 7. Slice Prefix -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsFileNameVisible}">
                                                <TextBlock Grid.Column="0" Text="文件前缀" Classes="label"/>
                                                <controls:ContinuousBorder Grid.Column="1"  Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0" 
                                                         Text="{Binding FileName}"
                                                         PlaceholderText="例如：商品主图"
                                                         VerticalContentAlignment="Center"
                                                         Padding="10,0"/></controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>


                                </Grid>
                            </controls:ContinuousBorder>
                            <controls:ContinuousBorder Margin="16,0,16,8" Padding="12,10"
                                IsVisible="{Binding !IsViewSetting}" CornerRadius="{StaticResource Radius.Md}"
                                Background="{StaticResource Brush.StatusSurface}" BorderBrush="{StaticResource Brush.StatusBorder}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="任务状态" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ExportedCount, StringFormat='已生成 {0} 个文件'}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ExportStatusText}" TextWrapping="Wrap" FontSize="12"/>
                                    <controls:ContinuousBorder CornerRadius="2" IsVisible="{Binding IsExporting}"><ProgressBar CornerRadius="0" IsIndeterminate="True"/></controls:ContinuousBorder>
                                </StackPanel>
                            </controls:ContinuousBorder>
                        </StackPanel>
                    </ScrollViewer>
                    <controls:ContinuousBorder IsVisible="{Binding IsViewSetting}"
                        Margin="16,6,16,12"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Padding.Panel}">
                        <!-- Settings Center -->
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="{StaticResource Space.Md}"
                              IsVisible="{Binding IsViewSetting}">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="{StaticResource Space.Xs}">
                                    <TextBlock Text="设置中心" Classes="title"/>
                                    <TextBlock Text="{Binding SettingsStatusText}" Classes="hint" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Command="{Binding SelectModeCommand}"
                                        CommandParameter="{x:Static models:ExportMode.QuickExport}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="返回导出"/>
                                </Button>
                            </Grid>

                            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Classes="subtle-scroll"
                                AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,4,4,8" Spacing="12">
<controls:ContinuousBorder Classes="settings-card"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="外观与交互" Classes="setting-card-title"/><TextBlock Text="显示与操作习惯" Classes="setting-description"/></StackPanel><StackPanel Spacing="8"><StackPanel Spacing="3"><TextBlock Text="界面主题" Classes="setting-label"/><TextBlock Text="即时切换，保持相同布局。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding ThemeMode}"><Grid ColumnDefinitions="*,*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.System}"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="跟随系统" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.System}}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Light}"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="浅色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.Light}}"/></controls:ContinuousBorder></Button><Button Grid.Column="2" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Dark}"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="深色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.Dark}}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></StackPanel><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="空白处拖动窗口" Classes="setting-label"/><TextBlock Text="按钮、输入框与质量条保留原操作。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding EnableBlankDrag}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableBlankDragCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableBlankDrag, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableBlankDragCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableBlankDrag, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="质量刻度动效" Classes="setting-label"/><TextBlock Text="悬停时轻微放大，点击区域保持不变。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding EnableQualityHoverAnimation}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableQualityHoverAnimationCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableQualityHoverAnimation, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableQualityHoverAnimationCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableQualityHoverAnimation, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid></StackPanel></controls:ContinuousBorder>
<controls:ContinuousBorder Classes="settings-card"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="窗口与收纳" Classes="setting-card-title"/><TextBlock Text="保持入口可见，减少来回移动" Classes="setting-description"/></StackPanel><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="普通窗口置顶" Classes="setting-label"/><TextBlock Text="收纳图标会独立保持置顶。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding IsAlwaysOnTop}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetAlwaysOnTopCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetAlwaysOnTopCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="贴边自动收纳" Classes="setting-label"/><TextBlock Text="拖到屏幕外侧边缘后收纳为图标。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding EnableEdgeSnap}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><StackPanel Spacing="8"><StackPanel Spacing="3"><TextBlock Text="自动收回等待" Classes="setting-label"/><TextBlock Text="鼠标移出宽松保持区后再计时。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding DockRetractDelayMs}"><Grid ColumnDefinitions="*,*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="250"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="快速 · 250ms" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=250}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="420"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="标准 · 420ms" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=420}"/></controls:ContinuousBorder></Button><Button Grid.Column="2" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="800"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="从容 · 800ms" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=800}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></StackPanel></StackPanel></controls:ContinuousBorder>
<controls:ContinuousBorder Classes="settings-card"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="Photoshop 联动" Classes="setting-card-title"/><TextBlock Text="PS 在前台时检查，导出期间暂停" Classes="setting-description"/></StackPanel><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="文档自动同步" Classes="setting-label"/><TextBlock Text="切换、打开或关闭文档后同步参数。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding AutoRefreshOnActivated}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><StackPanel Spacing="8"><StackPanel Spacing="3"><TextBlock Text="同步检查间隔" Classes="setting-label"/><TextBlock Text="快速更灵敏，省电减少后台检查。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding DocumentSyncIntervalMs}"><Grid ColumnDefinitions="*,*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="800"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="快速 · 0.8秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=800}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="1200"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="标准 · 1.2秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=1200}"/></controls:ContinuousBorder></Button><Button Grid.Column="2" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="2000"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="省电 · 2秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=2000}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></StackPanel></StackPanel></controls:ContinuousBorder>
<controls:ContinuousBorder Classes="settings-card"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="导出与命名" Classes="setting-card-title"/><TextBlock Text="同名处理与一级图层命名规则" Classes="setting-description"/></StackPanel><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="同名自动改名" Classes="setting-label"/><TextBlock Text="开启时追加序号；关闭时覆盖同名文件。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding AutoRename}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoRenameCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoRename, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoRenameCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoRename, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="文档名前缀" Classes="setting-label"/><TextBlock Text="未填写图层前缀时使用文档名称。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding LayerExportWithDocName}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetLayerExportWithDocNameCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding LayerExportWithDocName, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetLayerExportWithDocNameCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding LayerExportWithDocName, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><Grid ColumnDefinitions="*,112" ColumnSpacing="16" MinHeight="44"><StackPanel Spacing="3"><TextBlock Text="文档名优先" Classes="setting-label"/><TextBlock Text="开启时以文档名替代手动图层前缀。" Classes="setting-description"/></StackPanel><controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding AutoUseDocNameAsPrefix}"><Grid ColumnDefinitions="*,*"><Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoUseDocNameAsPrefixCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoUseDocNameAsPrefix, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button><Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoUseDocNameAsPrefixCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoUseDocNameAsPrefix, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button></Grid></controls:AnimatedSegmentTrack></Grid><StackPanel Spacing="8"><TextBlock Text="默认导出参数" Classes="setting-label"/><TextBlock Text="{Binding DefaultExportSummary}" Classes="setting-description"/><Button Classes="secondary" Command="{Binding SaveAsDefaultCommand}" HorizontalAlignment="Left" Content="将当前导出参数保存为默认"/></StackPanel></StackPanel></controls:ContinuousBorder>
<controls:ContinuousBorder Classes="settings-card"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="数据与运行记录" Classes="setting-card-title"/><TextBlock Text="设置保存在用户数据目录，日志位于 EXE 同级的 psx.log" Classes="setting-description"/></StackPanel><StackPanel Spacing="8"><TextBlock Text="{Binding DataDirectory}" Classes="setting-description"/><Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录"/></StackPanel></StackPanel></controls:ContinuousBorder></StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </controls:ContinuousBorder>
                </Grid>

                <!-- Footer actions only -->
                <controls:ContinuousBorder Grid.Row="4"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Command="{Binding OpenExportFolderCommand}"
                                    IsVisible="{Binding CanOpenExportFolder}"
                                    ToolTip.Tip="在资源管理器中打开导出目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="打开目录" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary"
                                    Command="{Binding StartExportCommand}"
                                    IsVisible="{Binding !IsExporting}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Play}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="开始导出" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary"
                                    Command="{Binding CancelExportCommand}"
                                    IsVisible="{Binding IsExporting}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="停止等待当前任务；Photoshop 可能仍会继续处理">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Stop}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="停止等待" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:ContinuousBorder>
                <!-- 描边只绘制，不挤占标题栏布局；按钮背景可延伸到右上边缘。 -->
                <controls:ContinuousBorder Grid.RowSpan="5" ZIndex="50" IsHitTestVisible="False"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"/>
            </Grid>
        </controls:ContinuousBorder>

        <!-- Transparent resize hit areas for the borderless window -->
        <controls:ContinuousBorder Height="6" VerticalAlignment="Top" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"/>
        <controls:ContinuousBorder Height="6" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"/>
        <controls:ContinuousBorder Width="6" HorizontalAlignment="Left" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"/>
        <controls:ContinuousBorder Width="6" HorizontalAlignment="Right" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"/>

        <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"/>
        <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"/>
        <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"/>
        <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"/>
    </Grid>
</Window>
