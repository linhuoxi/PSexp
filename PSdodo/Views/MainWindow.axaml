<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PsExporter.Controls"
        xmlns:vm="using:PsExporter.ViewModels"
        xmlns:models="using:PsExporter.Models"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PsExporter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ico.ico"
        Title="{Binding ApplicationTitle}"
        Focusable="True"
        Width="{x:Static models:AppSettings.DefaultWindowWidth}"
        Height="{x:Static models:AppSettings.DefaultWindowHeight}"
        MinWidth="{x:Static models:AppSettings.MinimumWindowWidth}"
        MinHeight="{x:Static models:AppSettings.MinimumWindowHeight}"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Classes.quality-motion="{Binding EnableQualityHoverAnimation}"
        Topmost="{Binding EffectiveTopmost}">

    <Grid x:Name="RootGrid">
        <controls:ContinuousBorder x:Name="MainContentBorder"
                Margin="{StaticResource Window.ShadowMargin}"
                BoxShadow="{StaticResource Shadow.Window}"
                Background="{StaticResource Brush.Canvas}"
                BorderThickness="0"
                CornerRadius="{StaticResource Radius.Lg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Header TitleBar -->
                <controls:ContinuousBorder Grid.Row="0"
                        Background="{StaticResource Brush.Surface}"
                        BorderThickness="0"
                        Padding="0"
                        Height="{StaticResource Control.CaptionHeight}"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Application Logo -->
                        <Image Margin="16,0,0,0" Width="{StaticResource Control.LogoSize}"
                               Height="{StaticResource Control.LogoSize}"
                               Source="/Assets/ico.ico"
                               Stretch="Uniform"
                               VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{Binding ApplicationTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   Classes="subtitle"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding RefreshStatusCommand}"
                                IsEnabled="{Binding CanRefreshStatus}"
                                ToolTip.Tip="刷新 Photoshop 状态与当前文档">
                            <TextBlock x:Name="RefreshIcon"
                                       Text="{StaticResource Icon.Refresh}"
                                       Classes="icon"
                                       Foreground="{Binding IsRefreshingStatus, Converter={x:Static vm:BoolToRefreshBrushConverter.Instance}}"
                                       RenderTransformOrigin="50%,50%"/>
                        </Button>
                        <Button Grid.Column="3"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ToggleAlwaysOnTopCommand}"
                                ToolTip.Tip="窗口置顶">
                            <controls:ContinuousBorder Background="{Binding IsAlwaysOnTop, Converter={x:Static vm:BoolToSettingBrushConverter.Instance}}"
                                    CornerRadius="{StaticResource Radius.SegmentInner}"
                                    Width="{StaticResource Control.ToolSize}"
                                    Height="{StaticResource Control.ToolSize}" BorderBrush="{Binding IsAlwaysOnTop, Converter={x:Static vm:ChoiceBorderConverter.Instance}}" BorderThickness="1">
                                <TextBlock Text="{StaticResource Icon.Pin}"
                                           Classes="icon"
                                           Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:BoolToIconColorConverter.Instance}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </controls:ContinuousBorder>
                        </Button>
                        <Button Grid.Column="4"
                                Margin="8,0,8,0" VerticalAlignment="Center"
                                Classes="tool"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ShowSettingsCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                ToolTip.Tip="{Binding SettingsUpdateHint}">
                            <Grid Width="20" Height="20"><TextBlock Text="{StaticResource Icon.Settings}" Classes="icon" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="6" Height="6" Fill="{StaticResource Brush.StatusText}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsUpdateAvailable}" IsHitTestVisible="False"/></Grid>
                        </Button>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Classes="tool caption" Click="OnMinimizeClick"
                                    chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                                    ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
                                <Path Classes="caption-glyph" Data="M0 0H12V1H0Z" Width="12" Height="1" Stretch="Fill"
                                      Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                            <Button Classes="tool caption close" Click="OnCloseClick"
                                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                    ToolTip.Tip="{Binding WindowCloseHint}" AutomationProperties.Name="{Binding WindowCloseHint}">
                                <Path Classes="caption-glyph" Data="M0 0L12 12 M12 0L0 12" Width="12" Height="12" Stretch="Fill"
                                      StrokeThickness="1.3" Stroke="{Binding $parent[Button].Foreground}"/>
                            </Button>
                        </StackPanel>
                        <controls:ContinuousBorder Grid.ColumnSpan="6" Height="1" VerticalAlignment="Bottom"
                            Background="{StaticResource Brush.Divider}" IsHitTestVisible="False"/>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 1. Photoshop Connection Console -->
                <controls:ContinuousBorder Grid.Row="1"
                        Margin="16,12,16,6"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.StatusBorder}"
                        BorderThickness="{StaticResource Thickness.Thin}"
                        CornerRadius="{StaticResource Radius.Md}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="5,*">
                        <controls:ContinuousBorder Grid.Column="0"
                                Background="Transparent"/>

                        <Grid Grid.Column="1"
                              Margin="13,12,13,12"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="当前 Photoshop 文档"
                                           Classes="micro"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="PsStatusDot"
                                         Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding IsPsRunning, Converter={x:Static vm:BoolToStatusBrushConverter.Instance}}"
                                         RenderTransformOrigin="50%,50%"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding DocumentDisplayName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="*,1,*,1,*"
                                  ColumnSpacing="12"
                                  HorizontalAlignment="Stretch">
                                <StackPanel Grid.Column="0"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="PS 版本"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding PsVersionDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="1"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2"
                                            Spacing="1"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="画布尺寸"
                                               Classes="micro"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding DocumentSizeDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>

                                <controls:ContinuousBorder Grid.Column="3"
                                        Width="1"
                                        Height="36"
                                        Background="{StaticResource Brush.Divider}"
                                        VerticalAlignment="Center"/>

                                <controls:ContinuousBorder Grid.Column="4"
                                        Background="{StaticResource Brush.Accent}"
                                        CornerRadius="{StaticResource Radius.Sm}"
                                        Padding="9,5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="当前模式"
                                                   Classes="micro"
                                                   Foreground="#DDE0FF"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentModeTitle}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </controls:ContinuousBorder>
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:ContinuousBorder>

                <!-- 2. Mode Selector: 4 Equal Columns Segmented Control -->
                <controls:AnimatedSegmentTrack Grid.Row="2"
                        Margin="16,6,16,6"
                        IsVisible="{Binding !IsViewSetting}" Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.QuickExport}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="快速导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.QuickExport}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="1"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.AllArtboards}"
                                controls:AnimatedSegmentTrack.SelectionAlias="{x:Static models:ExportMode.SelectedArtboards}"
                                IsEnabled="{Binding CanUseArtboards}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="画板导出"
                                           Classes="mode-label"
                                           Foreground="{Binding IsArtboardMode, Converter={x:Static vm:BoolToIconColorConverter.Instance}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Layers}"
                                IsEnabled="{Binding CanChangeMode}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="图层导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Layers}}"/>
                            </controls:ContinuousBorder>
                        </Button>

                        <Button Grid.Column="3"
                                Classes="mode"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="{x:Static models:ExportMode.Slices}"
                                IsEnabled="{Binding CanUseSlices}">
                            <controls:ContinuousBorder Classes="mode-fill"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                <TextBlock Text="切片导出"
                                           Classes="mode-label"
                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:ExportModeIconColorConverter.Instance}, ConverterParameter={x:Static models:ExportMode.Slices}}"/>
                            </controls:ContinuousBorder>
                        </Button>
                    </Grid>
                </controls:AnimatedSegmentTrack>

                <!-- 参数与任务状态按内容排布，共用一个受窗口约束的滚动区。 -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ExportScrollViewer" Classes="subtle-scroll"
                        IsVisible="{Binding !IsViewSetting}" AllowAutoHide="False"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <controls:ContinuousBorder Margin="16,6,16,12"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}" Padding="{StaticResource Padding.Panel}">
                                <!-- Export Panel -->
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="{StaticResource Space.Md}">

                                    <controls:ContinuousBorder Grid.Row="0" Classes="workspace-heading">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <controls:ContinuousBorder Width="4"
                                                        Height="22"
                                                        Background="{StaticResource Brush.Accent}"
                                                        CornerRadius="2"/>
                                                <TextBlock Text="{Binding CurrentModeTitle}"
                                                           Classes="title"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Classes="output-meta" Orientation="Horizontal" Height="{StaticResource Control.BadgeHeight}"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="输出参数"
                                                           Classes="micro meta-label"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           VerticalAlignment="Center"/>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="JPG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding !IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Text="PNG"
                                                               Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               FontWeight="SemiBold"/>
                                                </controls:ContinuousBorder>
                                                <controls:ContinuousBorder Background="{StaticResource Brush.StatusSurface}"
                                                        BorderBrush="{StaticResource Brush.StatusBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding IsJpgFormat}" Classes="meta-badge">
                                                    <TextBlock Classes="micro meta-label"
                                                               Foreground="{StaticResource Brush.StatusText}"
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding Quality}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </controls:ContinuousBorder>
                                            </StackPanel>
                                        </Grid>
                                    </controls:ContinuousBorder>

                                        <StackPanel Grid.Row="1" Margin="0,6,0,8" Spacing="16">
                                            <!-- Output destination is shared by every export mode. -->
                                            <StackPanel Spacing="8" IsEnabled="{Binding CanChangeMode}">
                                                <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                                    <TextBlock Text="输出位置" Classes="label" VerticalAlignment="Center"/>
                                                    <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding Destination}">
                                                        <Grid ColumnDefinitions="*,*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                CommandParameter="{x:Static models:ExportDestination.DocumentFolder}" ToolTip.Tip="导出到当前 Photoshop 文档所在的文件夹；文档需先保存。">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="文档位置" Classes="mode-label"
                                                                    Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.DocumentFolder}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                CommandParameter="{x:Static models:ExportDestination.Desktop}" ToolTip.Tip="使用 Windows 的实际桌面目录，兼容桌面重定向。">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="桌面" Classes="mode-label"
                                                                    Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.Desktop}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="seg" Command="{Binding SetDestinationCommand}"
                                                                CommandParameter="{x:Static models:ExportDestination.Custom}" ToolTip.Tip="输入或选择目录；切换预设会保留之前填写的路径。">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="自定义" Classes="mode-label"
                                                                    Foreground="{Binding Destination, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportDestination.Custom}}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="88,0,0,0" IsVisible="{Binding IsCustomDestination}">
                                                    <controls:ContinuousBorder Classes="input-shell" Height="{StaticResource Control.InputHeight}"
                                                        CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                        <TextBox Background="Transparent" BorderThickness="0" Text="{Binding ExportPath}"
                                                            PlaceholderText="输入或选择文件夹" AutomationProperties.Name="自定义输出路径"
                                                            VerticalContentAlignment="Center" Padding="10,0"/>
                                                    </controls:ContinuousBorder>
                                                    <Button Grid.Column="1" Classes="folder" Command="{Binding BrowseExportFolderCommand}"
                                                        ToolTip.Tip="选择输出文件夹" AutomationProperties.Name="选择输出文件夹">
                                                        <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon"/>
                                                    </Button>
                                                </Grid>
                                                <Grid Margin="88,0,0,0" IsVisible="{Binding IsPresetDestination}">
                                                    <TextBlock Text="{Binding ResolvedExportPath}" IsVisible="{Binding HasExportTarget}"
                                                        Classes="settings-caption" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                        ToolTip.Tip="{Binding ResolvedExportPath}"/>
                                                </Grid>
                                                <TextBlock Margin="88,0,0,0" Text="{Binding DestinationHint}" IsVisible="{Binding !HasExportTarget}"
                                                    Classes="setting-description" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- 2. Format Selector -->
                                            <Grid ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="图片格式" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding Format}">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SetFormatCommand}"
                                                                CommandParameter="{x:Static models:ExportFormat.Jpg}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="JPG 格式"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Jpg}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SetFormatCommand}"
                                                                CommandParameter="{x:Static models:ExportFormat.Png}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="PNG 无损"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding Format, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportFormat.Png}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <StackPanel IsVisible="{Binding IsLayerMode}" Spacing="8">
                                                <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                                    <TextBlock Text="导出模式" Classes="label"/>
                                                    <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding LayerExportRecursive}" IsEnabled="{Binding !IsExporting}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="一级图层" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetLayerExportRecursiveCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="图层" Classes="mode-label" Foreground="{Binding LayerExportRecursive, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" ColumnSpacing="12" IsVisible="{Binding ShowLayerSelection}">
                                                    <TextBlock Text="导出对象" Classes="label"/>
                                                    <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding LayerExportSelectedOnly}" IsEnabled="{Binding !IsExporting}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetLayerExportSelectedOnlyCommand}" CommandParameter="True"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="选中图层" Classes="mode-label" Foreground="{Binding LayerExportSelectedOnly, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/></controls:ContinuousBorder></Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetLayerExportSelectedOnlyCommand}" CommandParameter="False"><controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}"><TextBlock Text="全部图层" Classes="mode-label" Foreground="{Binding LayerExportSelectedOnly, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/></controls:ContinuousBorder></Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Grid>
                                                <StackPanel Margin="88,0,0,0" Spacing="3">
                                                    <TextBlock Text="{Binding LayerModeHint}" Classes="setting-description" TextWrapping="Wrap"/>
                                                    <TextBlock Text="“排除”前缀：不单独导出。" Classes="setting-description" TextWrapping="Wrap" ToolTip.Tip="排除组的子图层也跳过；背景和排除项保留原显示状态，作为合成内容。其他符合条件的隐藏图层仍可导出。"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 3. Quality: one field, one surface -->
                                            <Grid x:Name="QualityControl" Cursor="Arrow" ColumnDefinitions="76,*" ColumnSpacing="12" VerticalAlignment="Center" IsVisible="{Binding IsJpgFormat}">
                                                <TextBlock Text="图片质量" Classes="label"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="12">
                                                    <Grid x:Name="QualityMeter"
                                                              Cursor="Arrow"
                                                              Grid.Column="0"
                                                              ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
                                                              ColumnSpacing="1.5"
                                                              Height="{StaticResource Control.StandardHeight}"
                                                              VerticalAlignment="Center"
                                                              Background="Transparent"
                                                              ClipToBounds="False">
<Button Grid.Column="0" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="4" ToolTip.Tip="4%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=4}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="1" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="8" ToolTip.Tip="8%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=8}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="2" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="12" ToolTip.Tip="12%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=12}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="3" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="16" ToolTip.Tip="16%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=16}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="4" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="20" ToolTip.Tip="20%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=20}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="5" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="24" ToolTip.Tip="24%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=24}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="6" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="28" ToolTip.Tip="28%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=28}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="7" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="32" ToolTip.Tip="32%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=32}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="8" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="36" ToolTip.Tip="36%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=36}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="9" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="40" ToolTip.Tip="40%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=40}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="10" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="44" ToolTip.Tip="44%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=44}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="11" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="48" ToolTip.Tip="48%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=48}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="12" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="52" ToolTip.Tip="52%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=52}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="13" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="56" ToolTip.Tip="56%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=56}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="14" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="60" ToolTip.Tip="60%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=60}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="15" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="64" ToolTip.Tip="64%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=64}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="16" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="68" ToolTip.Tip="68%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=68}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="17" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="72" ToolTip.Tip="72%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=72}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="18" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="76" ToolTip.Tip="76%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=76}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="19" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="80" ToolTip.Tip="80%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=80}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="20" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="84" ToolTip.Tip="84%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=84}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="21" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="88" ToolTip.Tip="88%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=88}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="22" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="92" ToolTip.Tip="92%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=92}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="23" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="96" ToolTip.Tip="96%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=96}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
<Button Grid.Column="24" Classes="qcell" Command="{Binding SetQualityCommand}" CommandParameter="100" ToolTip.Tip="100%"><controls:ContinuousBorder Classes="quality-mark" Background="{Binding Quality, Converter={x:Static vm:QualityCellBrushConverter.Instance}, ConverterParameter=100}" CornerRadius="2" Height="{StaticResource Control.QualityMarkHeight}" VerticalAlignment="Center"/></Button>
                                                        </Grid>
                                                    <controls:ContinuousBorder Grid.Column="1" Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}"
                                                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBox x:Name="QualityInput" Text="{Binding Quality}" Height="{StaticResource Control.InputInnerHeight}" MinWidth="0" Padding="6,0,0,0"
                                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="%" Margin="0,0,8,0" Classes="hint" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </controls:ContinuousBorder>
                                                </Grid>
                                            </Grid>

                                            <!-- 4. Artboard export range -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsArtboardMode}">
                                                <TextBlock Grid.Column="0" Text="导出范围" Classes="label"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding SelectedMode}">
                                                    <Grid ColumnDefinitions="*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.AllArtboards}">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="全部画板"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.AllArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SelectModeCommand}"
                                                                CommandParameter="{x:Static models:ExportMode.SelectedArtboards}"
                                                                ToolTip.Tip="导出 Photoshop 中当前选中的画板">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="当前选中"
                                                                           Classes="mode-label"
                                                                           Foreground="{Binding SelectedMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportMode.SelectedArtboards}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <!-- 5. Artboard save location -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsArtboardMode}">
                                                <TextBlock Grid.Column="0" Text="存放方式" Classes="label" ToolTip.Tip="在上方输出目录内，选择直接保存画板图片或按文档名建文件夹。"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" SelectionValue="{Binding ExportPathOption}">
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.ImageOnly}"
                                                                ToolTip.Tip="直接将画板图片保存到当前选择的输出目录">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="图片直出"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.ImageOnly}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>

                                                        <Button Grid.Column="1"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.NewFolder}"
                                                                ToolTip.Tip="按当前 Photoshop 文档名新建文件夹；重名时自动追加序号，保留旧结果">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="文档文件夹"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolder}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>

                                                        <Button Grid.Column="2"
                                                                Classes="seg"
                                                                Command="{Binding SetExportPathOptionCommand}"
                                                                CommandParameter="{x:Static models:ExportPathOption.NewFolderOverwrite}"
                                                                ToolTip.Tip="使用当前 Photoshop 文档名文件夹；已存在时复用，并更新本次同名导出文件">
                                                            <controls:ContinuousBorder Background="Transparent"
                                                                    CornerRadius="{StaticResource Radius.SegmentInner}" BorderBrush="Transparent" BorderThickness="1">
                                                                <TextBlock Text="覆盖文件夹"
                                                                           Classes="mode-label"
                                                                           FontSize="11"
                                                                           Foreground="{Binding ExportPathOption, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:ExportPathOption.NewFolderOverwrite}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>

                                            <!-- 6. Mode-specific name -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsImageNameVisible}">
                                                <TextBlock Grid.Column="0" Text="{Binding ImageNameLabel}" Classes="label"/>
                                                <controls:ContinuousBorder Grid.Column="1"  Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0" 
                                                         Text="{Binding ImageName}"
                                                         PlaceholderText="{Binding ImageNamePlaceholder}"
                                                         VerticalContentAlignment="Center"
                                                         Padding="10,0"/></controls:ContinuousBorder>
                                            </Grid>

                                            <!-- 7. Slice Prefix -->
                                            <Grid ColumnDefinitions="76,*"
                                                  ColumnSpacing="12"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsFileNameVisible}">
                                                <TextBlock Grid.Column="0" Text="文件前缀" Classes="label"/>
                                                <controls:ContinuousBorder Grid.Column="1"  Classes="input-shell" Height="{StaticResource Control.InputHeight}" CornerRadius="{StaticResource Radius.Sm}" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"><TextBox Background="Transparent" BorderThickness="0" 
                                                         Text="{Binding FileName}"
                                                         PlaceholderText="可留空，使用切片名称或序号"
                                                         VerticalContentAlignment="Center"
                                                         Padding="10,0"/></controls:ContinuousBorder>
                                            </Grid>
                                        </StackPanel>


                                </Grid>
                            </controls:ContinuousBorder>
                            <controls:ContinuousBorder Margin="16,0,16,8" Padding="12,10"
                                IsVisible="{Binding !IsViewSetting}" CornerRadius="{StaticResource Radius.Md}"
                                Background="{StaticResource Brush.StatusSurface}" BorderBrush="{StaticResource Brush.StatusBorder}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="任务状态" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ExportedCount, StringFormat='已生成 {0} 个文件'}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ExportStatusText}" TextWrapping="Wrap" FontSize="12"/>
                                    <controls:ContinuousBorder CornerRadius="2" IsVisible="{Binding IsExporting}"><ProgressBar CornerRadius="0" IsIndeterminate="True"/></controls:ContinuousBorder>
                                </StackPanel>
                            </controls:ContinuousBorder>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Settings sit directly on the window canvas; each group owns its card. -->
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12"
                          Margin="16,6,16,12" IsVisible="{Binding IsViewSetting}">
                        <Grid ColumnDefinitions="*,Auto" Width="{Binding #SettingsPageHost.Bounds.Width}" HorizontalAlignment="Left">
                            <TextBlock Text="设置" Classes="title" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="secondary" Command="{Binding HideSettingsCommand}" Content="返回导出"/>
                        </Grid>
                        <Panel Grid.Row="1" Width="{Binding #SettingsPageHost.Bounds.Width}" HorizontalAlignment="Left">
                            <controls:AnimatedSegmentTrack Classes="choice-track settings-tabs" SelectionValue="{Binding SelectedSettingsSection}">
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Classes="seg" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="0">
                                        <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                            <TextBlock Text="常规" Classes="mode-label" Foreground="{Binding SelectedSettingsSection, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=0}"/>
                                        </controls:ContinuousBorder>
                                    </Button>
                                    <Button Grid.Column="1" Classes="seg" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="1">
                                        <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                            <TextBlock Text="导出" Classes="mode-label" Foreground="{Binding SelectedSettingsSection, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=1}"/>
                                        </controls:ContinuousBorder>
                                    </Button>
                                    <Button Grid.Column="2" Classes="seg" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="2">
                                        <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                            <TextBlock Text="联动" Classes="mode-label" Foreground="{Binding SelectedSettingsSection, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=2}"/>
                                        </controls:ContinuousBorder>
                                    </Button>
                                    <Button Grid.Column="3" Classes="seg" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="3">
                                        <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                            <TextBlock Text="更新" Classes="mode-label" Foreground="{Binding SelectedSettingsSection, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=3}"/>
                                        </controls:ContinuousBorder>
                                    </Button>
                                </Grid>
                            </controls:AnimatedSegmentTrack>
                        </Panel>
                        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" Classes="subtle-scroll" AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="SettingsPageHost" Margin="0,4,8,8">
                                <StackPanel Classes="settings-page" IsVisible="{Binding IsSettingsGeneral}">
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="界面" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,168" ColumnSpacing="12">
                                                <TextBlock Text="主题" Classes="setting-label" VerticalAlignment="Center"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding ThemeMode}">
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <Button Grid.Column="0" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.System}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="跟随系统" ToolTip.Tip="跟随系统主题" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.System}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Light}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="浅色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.Light}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="seg" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static models:AppThemeMode.Dark}">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="深色" Classes="mode-label" Foreground="{Binding ThemeMode, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter={x:Static models:AppThemeMode.Dark}}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="空白处拖窗" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="按钮、输入框、滚动条和质量条保持各自操作。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding EnableBlankDrag}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableBlankDragCommand}" CommandParameter="False" AutomationProperties.Name="空白处拖窗：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableBlankDrag, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableBlankDragCommand}" CommandParameter="True" AutomationProperties.Name="空白处拖窗：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableBlankDrag, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="质量条悬停动效" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="控制悬停放大；点击和数值变化的反馈保留。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding EnableQualityHoverAnimation}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableQualityHoverAnimationCommand}" CommandParameter="False" AutomationProperties.Name="质量条悬停动效：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableQualityHoverAnimation, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableQualityHoverAnimationCommand}" CommandParameter="True" AutomationProperties.Name="质量条悬停动效：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableQualityHoverAnimation, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="窗口" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="关闭后常驻" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="关闭按钮收起到托盘；在托盘右键菜单中选择退出。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding CloseToTray}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetCloseToTrayCommand}" CommandParameter="False" AutomationProperties.Name="关闭后常驻：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding CloseToTray, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetCloseToTrayCommand}" CommandParameter="True" AutomationProperties.Name="关闭后常驻：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding CloseToTray, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="窗口置顶" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="主窗口保持置顶；收纳入口独立保持可见。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding IsAlwaysOnTop}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAlwaysOnTopCommand}" CommandParameter="False" AutomationProperties.Name="窗口置顶：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAlwaysOnTopCommand}" CommandParameter="True" AutomationProperties.Name="窗口置顶：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding IsAlwaysOnTop, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="贴边收纳" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="拖到屏幕边缘后收纳，悬停或点击入口展开。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding EnableEdgeSnap}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="False" AutomationProperties.Name="贴边收纳：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetEnableEdgeSnapCommand}" CommandParameter="True" AutomationProperties.Name="贴边收纳：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding EnableEdgeSnap, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,168" ColumnSpacing="12">
                                                <TextBlock Text="收回等待" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="鼠标移出后等待 250 / 420 / 800 毫秒再收回。"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding DockRetractDelayMs}" IsEnabled="{Binding EnableEdgeSnap}">
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <Button Grid.Column="0" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="250">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="快速" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=250}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="420">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="标准" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=420}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="seg" Command="{Binding SetDockRetractDelayCommand}" CommandParameter="800">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="从容" Classes="mode-label" Foreground="{Binding DockRetractDelayMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=800}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Classes="settings-page" IsVisible="{Binding IsSettingsExport}">
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="文件命名" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="同名自动改名" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="开启时追加序号，关闭时覆盖同名文件。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoRename}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoRenameCommand}" CommandParameter="False" AutomationProperties.Name="同名自动改名：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoRename, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoRenameCommand}" CommandParameter="True" AutomationProperties.Name="同名自动改名：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoRename, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="文档名前缀" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="未填写图层前缀时使用文档名称。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding LayerExportWithDocName}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetLayerExportWithDocNameCommand}" CommandParameter="False" AutomationProperties.Name="文档名前缀：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding LayerExportWithDocName, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetLayerExportWithDocNameCommand}" CommandParameter="True" AutomationProperties.Name="文档名前缀：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding LayerExportWithDocName, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="文档名优先" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="图层导出时，以文档名替代手动前缀。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoUseDocNameAsPrefix}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoUseDocNameAsPrefixCommand}" CommandParameter="False" AutomationProperties.Name="文档名优先：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoUseDocNameAsPrefix, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoUseDocNameAsPrefixCommand}" CommandParameter="True" AutomationProperties.Name="文档名优先：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoUseDocNameAsPrefix, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="默认导出参数" Classes="settings-group-title"/>
                                            <controls:ContinuousBorder Classes="settings-summary">
                                                <TextBlock Text="{Binding DefaultExportSummary}" Classes="setting-description" TextWrapping="Wrap"/>
                                            </controls:ContinuousBorder>
                                            <Button Classes="secondary" Command="{Binding SaveAsDefaultCommand}" Content="将当前参数设为默认" HorizontalAlignment="Stretch"/>
                                            <TextBlock Text="只在点击后保存当前导出参数。" Classes="settings-caption"/>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Classes="settings-page" IsVisible="{Binding IsSettingsLink}">
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Photoshop" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="自动同步文档" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="Photoshop 在前台时检查文档切换，导出期间暂停。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoRefreshOnActivated}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="False" AutomationProperties.Name="自动同步文档：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoRefreshOnActivatedCommand}" CommandParameter="True" AutomationProperties.Name="自动同步文档：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoRefreshOnActivated, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,168" ColumnSpacing="12">
                                                <TextBlock Text="检查间隔" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="更短的间隔响应更快；更长的间隔减少后台检查。"/>
                                                <controls:AnimatedSegmentTrack Grid.Column="1" Classes="choice-track" VerticalAlignment="Center" SelectionValue="{Binding DocumentSyncIntervalMs}" IsEnabled="{Binding AutoRefreshOnActivated}">
                                                    <Grid ColumnDefinitions="*,*,*">
                                                        <Button Grid.Column="0" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="800">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="0.8 秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=800}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="1200">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="1.2 秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=1200}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="seg" Command="{Binding SetDocumentSyncIntervalCommand}" CommandParameter="2000">
                                                            <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                <TextBlock Text="2 秒" Classes="mode-label" Foreground="{Binding DocumentSyncIntervalMs, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=2000}"/>
                                                            </controls:ContinuousBorder>
                                                        </Button>
                                                    </Grid>
                                                </controls:AnimatedSegmentTrack>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="数据与日志" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <StackPanel Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding DataDirectory}">
                                                    <TextBlock Text="设置目录" Classes="setting-label"/>
                                                    <TextBlock Text="偏好与默认参数" Classes="settings-caption"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary settings-directory-action" Command="{Binding OpenDataDirectoryCommand}"
                                                    Content="打开文件夹" ToolTip.Tip="{Binding DataDirectory}" AutomationProperties.Name="打开设置目录"/>
                                            </Grid>
                                            <controls:ContinuousBorder Classes="settings-separator"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <StackPanel Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{Binding LogFilePath}">
                                                    <TextBlock Text="日志目录" Classes="setting-label"/>
                                                    <TextBlock Text="运行及导出记录" Classes="settings-caption"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary settings-directory-action" Command="{Binding OpenLogDirectoryCommand}"
                                                    Content="打开文件夹" ToolTip.Tip="{Binding LogFilePath}" AutomationProperties.Name="打开日志目录"/>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                                <StackPanel Classes="settings-page" IsVisible="{Binding IsSettingsUpdate}">
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="自动更新" Classes="settings-group-title"/>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="自动检测" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="启动后及每 6 小时检查一次。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoCheckForUpdates}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoCheckForUpdatesCommand}" CommandParameter="False" AutomationProperties.Name="自动检测：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoCheckForUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoCheckForUpdatesCommand}" CommandParameter="True" AutomationProperties.Name="自动检测：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoCheckForUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                            <Grid Classes="settings-row" ColumnDefinitions="*,112" ColumnSpacing="12">
                                                <TextBlock Text="后台下载" Classes="setting-label" VerticalAlignment="Center" ToolTip.Tip="下载并校验后，由你确认重启安装。"/>
                                                <Panel Grid.Column="1">
                                                    <controls:AnimatedSegmentTrack Classes="choice-track" SelectionValue="{Binding AutoDownloadUpdates}">
                                                        <Grid ColumnDefinitions="*,*">
                                                            <Button Grid.Column="0" Classes="seg" Command="{Binding SetAutoDownloadUpdatesCommand}" CommandParameter="False" AutomationProperties.Name="后台下载：关闭">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="关闭" Classes="mode-label" Foreground="{Binding AutoDownloadUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=False}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                            <Button Grid.Column="1" Classes="seg" Command="{Binding SetAutoDownloadUpdatesCommand}" CommandParameter="True" AutomationProperties.Name="后台下载：开启">
                                                                <controls:ContinuousBorder Background="Transparent" CornerRadius="{StaticResource Radius.SegmentInner}">
                                                                    <TextBlock Text="开启" Classes="mode-label" Foreground="{Binding AutoDownloadUpdates, Converter={x:Static vm:EqualsToTextBrushConverter.Instance}, ConverterParameter=True}"/>
                                                                </controls:ContinuousBorder>
                                                            </Button>
                                                        </Grid>
                                                    </controls:AnimatedSegmentTrack>
                                                </Panel>
                                            </Grid>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                    <controls:ContinuousBorder Classes="settings-section">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="版本信息" Classes="settings-group-title" VerticalAlignment="Center"/>
                                                <controls:ContinuousBorder Grid.Column="1" Background="{DynamicResource Brush.SettingsTrack}" CornerRadius="{StaticResource Radius.SegmentInner}" Padding="8,4">
                                                    <TextBlock Text="{Binding UpdateVersionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                </controls:ContinuousBorder>
                                            </Grid>
                                            <TextBlock Text="{Binding UpdateStatus}" Classes="setting-description" TextWrapping="Wrap"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" IsVisible="{Binding IsUpdateBusy}" Height="4"/>
                                            <StackPanel Spacing="8" IsVisible="{Binding HasUpdateChangelog}">
                                                <controls:ContinuousBorder Classes="settings-separator"/>
                                                <TextBlock Text="更新内容" Classes="setting-label"/>
                                                <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding UpdateChangelog}" Classes="setting-description" TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Button Classes="secondary" Content="检查更新" Command="{Binding CheckForUpdatesCommand}"/>
                                                <Button Grid.Column="1" Classes="primary settings-update-action" Content="{Binding UpdateActionText}" Command="{Binding ApplyUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"/>
                                            </Grid>
                                            <TextBlock Text="确认重启后安装；导出期间暂不安装。" Classes="settings-caption" IsVisible="{Binding IsUpdateAvailable}" ToolTip.Tip="更新会校验文件并保留旧版备份。"/>
                                        </StackPanel>
                                    </controls:ContinuousBorder>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Spacing="8" Width="{Binding #SettingsPageHost.Bounds.Width}" HorizontalAlignment="Left">
                            <controls:ContinuousBorder Classes="settings-separator"/>
                            <TextBlock Text="{Binding SettingsStatusText}" Classes="settings-caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer actions only -->
                <controls:ContinuousBorder Grid.Row="4"
                        IsVisible="{Binding !IsViewSetting}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Command="{Binding OpenExportFolderCommand}"
                                    IsVisible="{Binding CanOpenExportFolder}"
                                    ToolTip.Tip="在资源管理器中打开导出目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{StaticResource Icon.Folder}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="打开目录" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="primary"
                                    Command="{Binding StartExportCommand}"
                                    IsVisible="{Binding !IsExporting}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Play}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="开始导出" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="secondary"
                                    Command="{Binding CancelExportCommand}"
                                    IsVisible="{Binding IsExporting}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="停止等待当前任务；Photoshop 可能仍会继续处理">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Sm}">
                                    <TextBlock Text="{StaticResource Icon.Stop}" Classes="icon" VerticalAlignment="Center"/>
                                    <TextBlock Text="停止等待" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:ContinuousBorder>
                <!-- 描边只绘制，不挤占标题栏布局；按钮背景可延伸到右上边缘。 -->
                <controls:ContinuousBorder Grid.RowSpan="5" ZIndex="50" IsHitTestVisible="False"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"/>
            </Grid>
        </controls:ContinuousBorder>

        <!-- Resize hit areas straddle the visible surface edge, inside the shadow margin. -->
        <Grid Margin="8">
            <controls:ContinuousBorder Height="6" VerticalAlignment="Top" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeN"/>
            <controls:ContinuousBorder Height="6" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeS"/>
            <controls:ContinuousBorder Width="6" HorizontalAlignment="Left" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeW"/>
            <controls:ContinuousBorder Width="6" HorizontalAlignment="Right" Background="Transparent" ZIndex="1000"
                chrome:WindowDecorationProperties.ElementRole="ResizeE"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNW"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeNE"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSW"/>
            <controls:ContinuousBorder Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" ZIndex="1001"
                chrome:WindowDecorationProperties.ElementRole="ResizeSE"/>
        </Grid>
    </Grid>
</Window>
