// 导出 PS 当前选中的图层/画板（UXP 版）
// 原理：尊重用户在 PS 里的当前选择，调用 exportSelectionAsFileTypePressed
// 占位符: {{EXPORT_PATH}} {{FORMAT}} {{QUALITY}} {{RENAME}}
const { app, core, action } = require("photoshop");
const { batchPlay } = action;

async function exportSelectedArtboards() {
    const exportPath = "{{EXPORT_PATH}}";
    const format = "{{FORMAT}}".toLowerCase();
    let quality = {{QUALITY}};
    // PNG 固定用 32（与原版"选择画板导出PNG.js"一致）
    if (format === "png") quality = 32;

    // 在命令提交前读取本次活动文档/选择的数量，避免依赖过时的界面计数。
    let expectedFileCount = null;
    try {
        const layers = Array.from(app.activeDocument.activeLayers);
        if (layers.length) {
            const descriptors = await batchPlay(layers.map(layer => ({
                _obj: "get", _target: [{ _ref: "layer", _id: layer.id }],
                _options: { dialogOptions: "dontDisplay" }
            })), {});
            if (descriptors.length === layers.length && descriptors.every(item => item._obj !== "error"))
                expectedFileCount = (descriptors.every(item => item.artboardEnabled === true) ? descriptors.length : null);
        }
    } catch (_) { /* 读取数量失败时使用应用预期数或文件稳定性判断，不改用户选择。 */ }

    const d = {
        _options: { dialogOptions: "dontDisplay" },
        _obj: "exportSelectionAsFileTypePressed",
        null: {
            _ref: [{ _ref: "layer", _enum: "ordinal", _value: "targetEnum" }]
        },
        fileType: format,
        quality: quality,
        metadata: 0,
        destFolder: exportPath,
        sRGB: true,
        openWindow: false
    };

    const result = await batchPlay([d], {});
    if (result.some(item => item._obj === "error")) throw new Error(result.find(item => item._obj === "error").message || "Photoshop 导出失败");
    return { expectedFileCount };
}

async function runExport() {
    if (app.documents.length === 0) throw new Error("没有打开的文档");
    let exportResult = null;
    await core.executeAsModal(async () => { exportResult = await exportSelectedArtboards(); }, { commandName: "Export Selection" });
    return exportResult;
}
