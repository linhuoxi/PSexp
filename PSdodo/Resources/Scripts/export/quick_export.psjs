// 明确等待整张画布副本保存，不使用提前返回的 Export As 后台任务。
const { app, core } = require("photoshop");
async function runExport() {
    if (app.documents.length === 0) throw new Error("没有打开的文档");
    const exportPath = "{{EXPORT_PATH}}";
    const format = "{{FORMAT}}".toLowerCase();
    const quality = {{QUALITY}};
    await core.executeAsModal(async () => {
        const doc = app.activeDocument;
        const folder = await require("uxp").storage.localFileSystem.getEntryWithUrl("file:/" + exportPath.replace(/\\/g, "/").replace(/\/$/, ""));
        const name = doc.name.replace(/\.[^.]+$/, "").replace(/[\\/:*?"<>|\x00-\x1f]/g, "_").replace(/[. ]+$/, "") || "export";
        const entry = await folder.createFile(name + "." + format, { overwrite: true });
        if (format === "png") await doc.saveAs.png(entry, {}, true);
        else if (format === "jpg") await doc.saveAs.jpg(entry, { quality: Math.round(12 * quality / 100) }, true);
        else throw new Error("不支持的导出格式: " + format);
    }, { commandName: "Export Canvas" });
}
