// 图层导出：一级图层 / 递归叶子图层，共用 UXP 实现。
// 每次 saveAs 完成后回传文件清单；恢复可见性后才发布 done 回执。
const { app, core } = require("photoshop");
const fs = require("uxp").storage.localFileSystem;

const recursive = {{RECURSIVE}};
const selectedOnly = {{SELECTED_ONLY}};
const exportFolderUrl = "{{EXPORT_FOLDER_URL}}";
const resultFolderUrl = "{{RESULT_FOLDER_URL}}";
const format = "{{FORMAT}}".toLowerCase();
const quality = {{QUALITY}};
const rename = {{RENAME}};
const imageName = "{{IMAGE_NAME}}";

const withDocName = {{WITH_DOC_NAME}};
const state = { done: false, success: false, files: [], error: "" };
let resultFile;
let stage = "创建任务回执";
let activePath = resultFolderUrl;

function safeName(value) {
    const name = String(value).replace(/[\\/:*?"<>|\x00-\x1f]/g, "_").replace(/[. ]+$/, "");
    return name || "未命名";
}

async function report() {
    state.stage = stage;
    state.path = activePath;
    await resultFile.write(JSON.stringify(state));
}

async function exportBatch(executionContext) {
    if (app.documents.length === 0) throw new Error("没有打开的文档");
    const doc = app.activeDocument;
    const roots = Array.from(doc.layers);
    const nodes = [];
    function visit(items, parents = [], excluded = false) {
        for (const layer of items) {
            const blocked = excluded || /^排除/.test(layer.name);
            const children = layer.layers ? Array.from(layer.layers) : [];
            nodes.push({ layer, parents, blocked, group: children.length > 0 || layer.kind === "group" });
            visit(children, [...parents, layer.id], blocked);
        }
    }
    visit(roots);
    const layers = nodes.map(node => node.layer);
    const visibility = new Map(layers.map(layer => [layer.id, layer.visible]));
    // 选中模式以 Photoshop 原生选择为准；选中组整体输出，避免组与其子层重复导出。
    const selectedIds = new Set(selectedOnly ? Array.from(doc.activeLayers).map(layer => layer.id) : []);
    const targets = nodes.filter(node => !node.blocked && !node.layer.isBackgroundLayer &&
        (!recursive ? node.parents.length === 0 : selectedOnly
            ? selectedIds.has(node.layer.id) && !node.parents.some(id => selectedIds.has(id))
            : !node.group)).map(node => node.layer);
    if (targets.length === 0) throw new Error(selectedOnly ? "请在 Photoshop 中选择可导出的图层；排除项不会导出" : "没有符合条件的图层");
    stage = "读取导出目录";
    activePath = exportFolderUrl;
    const folder = await fs.getEntryWithUrl(exportFolderUrl);
    stage = "枚举导出目录";
    const existingNames = new Set((await folder.getEntries()).map(entry => entry.name.toLowerCase()));
    const docName = safeName(doc.name.replace(/\.[^.]+$/, ""));
    const prefix = imageName ? safeName(imageName) : (withDocName ? docName : "");
    let failure;
    try {
        for (const target of targets) {
            if (executionContext.isCancelled) throw new Error("Photoshop 已取消导出");
            stage = "切换图层可见性";
            activePath = target.name;
            for (const layer of [...layers].reverse()) {
                // 背景与排除分支保留原显示状态；递归目标同时展开祖先组。
                const node = nodes.find(item => item.layer.id === layer.id);
                const targetNode = nodes.find(item => item.layer.id === target.id);
                const visible = layer.id === target.id || targetNode.parents.includes(layer.id) ||
                    ((node.blocked || layer.isBackgroundLayer || node.parents.includes(target.id)) && visibility.get(layer.id));
                if (layer.visible !== visible) layer.visible = visible;
            }
            const stem = (prefix ? prefix + "_" : "") + safeName(target.name);
            let name = stem + "." + format;
            if (rename) {
                let index = 1;
                while (existingNames.has(name.toLowerCase())) name = stem + "_" + index++ + "." + format;
            }
            stage = "创建导出文件";
            activePath = exportFolderUrl + "/" + name;
            const entry = await folder.createFile(name, { overwrite: !rename });
            stage = "保存 " + format.toUpperCase() + " 副本";
            if (format === "png") await doc.saveAs.png(entry, {}, true);
            else if (format === "jpg") await doc.saveAs.jpg(entry, { quality: Math.round(12 * quality / 100) }, true);
            else throw new Error("不支持的导出格式: " + format);
            existingNames.add(name.toLowerCase());
            // 覆盖模式下不同图层可以同名；回执记录最终文件而非重复路径。
            if (!state.files.some(existing => existing.toLowerCase() === name.toLowerCase())) state.files.push(name);
            stage = "写入导出进度";
            activePath = resultFolderUrl + "/result.json";
            await report();
        }
    } catch (error) {
        failure = error;
    } finally {
        // 尽力恢复每一个图层，一层失败不能阻止其他图层恢复。
        const restoreErrors = [];
        for (const layer of [...layers].reverse()) {
            try {
                if (layer.visible !== visibility.get(layer.id)) layer.visible = visibility.get(layer.id);
            } catch (error) { restoreErrors.push(layer.name + ": " + String(error)); }
        }
        if (restoreErrors.length) {
            failure = new Error((failure ? String(failure) + "; " : "") + "恢复图层可见性失败: " + restoreErrors.join("; "));
        }
    }
    if (failure) throw failure;
}

try {
    const resultFolder = await fs.getEntryWithUrl(resultFolderUrl);
    resultFile = await resultFolder.createFile("result.json", { overwrite: true });
    await report();
    stage = "检查文档与导出目标";
    activePath = exportFolderUrl;
    await core.executeAsModal(exportBatch, { commandName: recursive ? "Export All Layers" : "Export Top-level Layers" });
    state.success = true;
} catch (error) {
    state.error = stage + " [" + activePath + "]：" + String(error);
    state.stack = error && error.stack ? String(error.stack) : "";
} finally {
    state.done = true;
    if (resultFile) await report();
    else console.error("无法创建导出回执: " + state.error);
}
